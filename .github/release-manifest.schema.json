{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expressways.local/schemas/release-manifest.schema.json",
  "title": "Expressways Release Manifest",
  "type": "object",
  "required": [
    "channel",
    "version",
    "generated_at",
    "notes",
    "checksums",
    "artifacts"
  ],
  "additionalProperties": false,
  "properties": {
    "channel": {
      "type": "string",
      "enum": ["alpha", "beta", "stable"]
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+([-.][A-Za-z0-9]+)*$"
    },
    "generated_at": {
      "type": "string",
      "description": "UTC timestamp in RFC3339 format."
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "checksums": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Fa-f0-9]{64}$"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["bundle", "sha256"],
        "additionalProperties": false,
        "properties": {
          "bundle": {
            "type": "string",
            "pattern": "\\.tar\\.gz$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          }
        }
      }
    },
    "sbom": {
      "type": "object",
      "required": ["format", "path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "enum": ["cyclonedx-json"]
        },
        "path": {
          "type": "string",
          "pattern": "\\.cdx\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },
    "signatures": {
      "type": "object",
      "required": ["algorithm", "public_key", "public_key_sha256", "artifacts"],
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "type": "string",
          "minLength": 1
        },
        "public_key": {
          "type": "string",
          "minLength": 1
        },
        "public_key_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "sha256", "signature", "signature_sha256"],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "signature": {
                "type": "string",
                "pattern": "\\.sig$"
              },
              "signature_sha256": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
