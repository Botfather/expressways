{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expressways.local/schemas/interop-chat-handoff-v1.schema.json",
  "title": "Expressways Interop Chat Handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_runtime",
    "session",
    "message",
    "received_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "interop.chat.handoff.v1"
    },
    "source_runtime": {
      "type": "string",
      "minLength": 1
    },
    "target_runtime": {
      "type": "string",
      "minLength": 1
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "channel",
        "account_id",
        "sender_id"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "account_id": {
          "type": "string",
          "minLength": 1
        },
        "sender_id": {
          "type": "string",
          "minLength": 1
        },
        "sender_display_name": {
          "type": "string"
        },
        "message_id": {
          "type": "string"
        },
        "reply_to_message_id": {
          "type": "string"
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attachment_ref"
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "workspace": {
          "type": "string"
        },
        "skill_hint": {
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "attachment_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "content_type": {
          "type": "string"
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
